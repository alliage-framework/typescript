{
  "name": "@alliage/typescript",
  "version": "1.0.0-beta.5",
  "description": "TypeScript module for Alliage framework",
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/alliage-framework/typescript.git",
  "author": "Boris LEBON <bo.lebon@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.json",
    "clean": "rm -rf ./dist",
    "lint": "eslint . --ext .js --ext .ts",
    "lint:fix": "yarn lint --fix",
    "test:unit": "NODE_ENV=test vitest run --coverage",
    "test": "yarn lint && yarn test:unit",
    "test:integration": "vitest run --config integration-tests/vitest.config.ts",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "alliageManifest": {
    "type": "module",
    "dependencies": [
      "@alliage/lifecycle",
      "@alliage/di",
      "@alliage/config-loader",
      "@alliage/module-installer",
      "@alliage/builder"
    ],
    "environments": [
      "development"
    ],
    "installationProcedures": {
      "copyFiles": [
        [
          "base-files/tsconfig.json",
          "tsconfig.json"
        ]
      ]
    }
  },
  "devDependencies": {
    "@alliage/builder": "^0.1.0-beta.6",
    "@alliage/config-loader": "^0.1.0-beta.6",
    "@alliage/di": "^0.1.0-beta.6",
    "@alliage/framework": "^1.0.0-beta.4",
    "@alliage/lifecycle": "^0.1.0-beta.6",
    "@alliage/module-installer": "^0.1.0-beta.6",
    "@alliage/parameters-loader": "^0.1.0-beta.6",
    "@alliage/process-manager": "^0.1.0-beta.6",
    "@alliage/sandbox": "^1.0.0-beta.4",
    "@alliage/service-loader": "^0.1.0-beta.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "3.1.4",
    "eslint": "^9.27.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  },
  "peerDependencies": {
    "@alliage/framework": "^1.0.0-beta.4",
    "@alliage/lifecycle": "^0.1.0-beta.6",
    "@alliage/di": "^0.1.0-beta.6",
    "@alliage/config-loader": "^0.1.0-beta.6",
    "@alliage/module-installer": "^0.1.0-beta.6",
    "@alliage/builder": "^0.1.0-beta.6",
    "typescript": "^5.8.3",
    "tsx": "^4.19.4"
  },
  "dependencies": {
    "json-schema-to-ts": "^3.1.1"
  }
}
