{
  "name": "@alliage/typescript",
  "version": "1.0.0-beta.4",
  "description": "TypeScript module for Alliage framework",
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "git@github.com:alliage-framework/typescript.git",
  "author": "Boris LEBON <bo.lebon@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.json",
    "clean": "rm -rf ./dist",
    "lint": "eslint . --ext .js --ext .ts",
    "lint:fix": "yarn lint --fix",
    "test:unit": "NODE_ENV=test jest --maxWorkers=2 --coverage",
    "test:integration": "NODE_ENV=test jest --maxWorkers=2 --rootDir=. -c ./integration-tests/jest.config.js",
    "test": "yarn lint && yarn test:unit",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "alliageManifest": {
    "type": "module",
    "dependencies": [
      "@alliage/lifecycle",
      "@alliage/di",
      "@alliage/config-loader",
      "@alliage/module-installer",
      "@alliage/builder"
    ],
    "environments": [
      "development"
    ],
    "installationProcedures": {
      "copyFiles": [
        [
          "base-files/tsconfig.json",
          "tsconfig.json"
        ]
      ]
    }
  },
  "devDependencies": {
    "@alliage/core": "^0.1.0-beta.3",
    "@alliage/framework": "^1.0.0-beta.3",
    "@alliage/sandbox": "^1.0.0-beta.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@typescript-eslint/typescript-estree": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "prettier": "^3.5.2",
    "semantic-release": "^24.2.3",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@alliage/framework\r": "null",
    "@alliage/lifecycle": "null",
    "@alliage/di": "null",
    "@alliage/config-loader": "null",
    "@alliage/module-installer": "null",
    "@alliage/builder": "null",
    "typescript": "^5.7.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
