{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2018",
    "module": "NodeNext",
    "lib": [
      "ESNext"
    ],
    "sourceMap": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./src",
    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* Module Resolution Options */
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    /* Advanced Options */
    "resolveJsonModule": true,
  },
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "integration-tests/**",
    "vitest.config.ts",
    "dist/**"
  ],
}